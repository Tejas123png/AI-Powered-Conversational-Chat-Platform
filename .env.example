# Environment Template for Backend
# Rename to .env in production / set these in your hosting dashboard (Render / Railway / Heroku)

# Port to listen on (auto-assigned by cloud hosts)
PORT=8080

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection String
mongoatlas_url=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
mongodbatlas_username=<username>
mongoatlas_password=<password>

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret Key (Generate a random 64-char string)
JWT_SECRET=your_super_secret_jwt_key_here

# (Optional) Frontend URL if deployed separately (e.g., on Vercel / Netlify)
# Example: https://my-gpt-chat.vercel.app
CLIENT_URL=
